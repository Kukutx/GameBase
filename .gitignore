# Godot 4+ generated state of each game project
.godot/
.import/
*.translation

# Links to the shared foundation and addons, created by tools/link.js
/games/*/gamebase/
/games/*/addons/

# Build, release and QA outputs, one directory per game
/build/
/dist/
/artifacts/

# Local export credentials
export.cfg
export_credentials.cfg

# Mono
.mono/
data_*/
mono_crash.*.json

# Node-based QA tooling cache
node_modules/

# Local development probes, references, and vendored upgrade staging
/.dev/

# Purchased/local licensed art - never commit or redistribute raw source assets
/games/*/game/art/licensed/
