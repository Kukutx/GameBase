# Godot 4+ generated state
.godot/
.import/
.build/

# Export output / local export credentials
export.cfg
export_credentials.cfg
build/*
!build/.gdignore
artifacts/*
!artifacts/.gdignore
dist/*
!dist/.gdignore

# Imported/generated resources
*.translation
*.import

# Mono
.mono/
data_*/
mono_crash.*.json

# Node-based QA tooling cache
node_modules/

# Local development probes, references, and vendored upgrade staging
.dev/

# Purchased/local licensed art - never commit or redistribute raw source assets
game/art/licensed/
