msgid "Ember Depths"
msgstr "余烬深渊"

msgid "A dungeon delve on Tiamat"
msgstr "基于 Tiamat 的地城探险"

msgid "Ember Camp"
msgstr "余烬营地"

msgid "The Depths"
msgstr "深渊"

msgid "Campfire"
msgstr "篝火"

msgid "Rest until tomorrow"
msgstr "休息到明天"

msgid "Descend into the depths"
msgstr "进入深渊"

msgid "Stairs Down"
msgstr "下行阶梯"

msgid "Descend deeper"
msgstr "继续深入"

msgid "Rope"
msgstr "绳索"

msgid "Climb back to camp"
msgstr "爬回营地"

msgid "Camp Merchant"
msgstr "营地商人"


msgid "Drink Potion"
msgstr "喝药水"

msgid "Next Item"
msgstr "下一个物品"

msgid "Health"
msgstr "生命"

msgid "Combat Lv %d"
msgstr "战斗 %d 级"

msgid "Depth %d · Deepest %d"
msgstr "第 %d 层 · 最深 %d 层"

msgid "The way on is open"
msgstr "前路已开"

msgid "Return to camp to save"
msgstr "回到营地才能存档"

msgid "No potion at hand"
msgstr "手头没有药水"

msgid "Rusty Sword"
msgstr "生锈的剑"

msgid "The blade you came down with. It still cuts."
msgstr "你带下来的那把剑，还算锋利。"

msgid "Iron Sword"
msgstr "铁剑"

msgid "A sound blade from the camp's forge."
msgstr "营地铁匠铺打造的结实长剑。"

msgid "Ember Blade"
msgstr "余烬之刃"

msgid "Forged from ember cores; it burns what it strikes."
msgstr "以余烬核心锻成，所击之处皆被灼烧。"

msgid "Health Potion"
msgstr "生命药水"

msgid "Restores 35 health."
msgstr "恢复 35 点生命。"

msgid "Slime Gel"
msgstr "史莱姆凝胶"

msgid "Sticky remains of a cave slime."
msgstr "洞穴史莱姆留下的黏糊残渣。"

msgid "Bone Shard"
msgstr "骨片"

msgid "A splinter of an old skeleton."
msgstr "一块古老骷髅的碎骨。"

msgid "Ember Core"
msgstr "余烬核心"

msgid "The still-warm heart of an ember wisp."
msgstr "余烬幽火尚有余温的核心。"

msgid "Cave Slime"
msgstr "洞穴史莱姆"

msgid "Skeleton"
msgstr "骷髅"

msgid "Ember Wisp"
msgstr "余烬幽火"

msgid "Combat"
msgstr "战斗"

msgid "Veteran"
msgstr "老兵"

msgid "Champion"
msgstr "勇者"

msgid "First Blood"
msgstr "初次见血"

msgid "Defeat a creature of the depths."
msgstr "击败一只深渊生物。"

msgid "Delver"
msgstr "深入者"

msgid "Reach depth 5."
msgstr "抵达第 5 层。"

msgid "Ember Heart"
msgstr "余烬之心"

msgid "Reach depth 10."
msgstr "抵达第 10 层。"

msgid "Forged in Fire"
msgstr "烈火淬炼"

msgid "Reach depth 10 with Damage Taken on Heavy."
msgstr "在承受伤害为「较重」时抵达第 10 层。"

msgid "Slayer"
msgstr "猎魔人"

msgid "Defeat 100 creatures of the depths, counting every run."
msgstr "击败 100 只深渊生物，所有冒险累计。"

msgid "Day"
msgstr "白昼"

msgid "Deepest %d"
msgstr "最深 %d 层"

msgid "Move with {move}. Press {interact} to use what is near."
msgstr "用 {move} 移动，按 {interact} 使用身旁的东西。"

msgid "Press {attack} to swing, {next_item} to take up the next item."
msgstr "按 {attack} 挥动武器，按 {next_item} 换下一件物品。"

msgid "Hurt? Press {drink_potion} to drink a health potion."
msgstr "受伤了？按 {drink_potion} 喝下生命药水。"

msgid "Old Delver"
msgstr "老探窟人"

msgctxt "dialogue"
msgid "Old Delver"
msgstr "老探窟人"

msgctxt "dialogue"
msgid "Back from the dark, or only on your way down?"
msgstr "从黑暗里回来了，还是正要下去？"

msgctxt "dialogue"
msgid "What lies below?"
msgstr "下面有什么？"

msgctxt "dialogue"
msgid "Slimes near the top, bones further down, and living embers deepest of all. The deeper you go, the harder they hit."
msgstr "上层是史莱姆，再往下是白骨，最深处是活着的余烬。越往下走，它们下手越狠。"

msgctxt "dialogue"
msgid "Any advice?"
msgstr "有什么忠告吗？"

msgctxt "dialogue"
msgid "Rest by the fire before you go, buy potions from the merchant, and climb back up while you still can."
msgstr "下去前在火堆边歇歇，从商人那里买些药水，趁还走得动就爬回来。"

msgctxt "dialogue"
msgid "Farewell."
msgstr "再会。"

msgctxt "dialogue"
msgid "Mind the embers."
msgstr "小心余烬。"

msgid "Depth %d"
msgstr "第 %d 层"

msgid "attack"
msgstr "攻击"

msgid "potion"
msgstr "药水"

msgid "next item"
msgstr "下一个物品"

msgid "Deepest Depth"
msgstr "最深层数"

msgid "Creatures Defeated"
msgstr "击败的生物"

msgid "Where to Start"
msgstr "从哪里出发"

msgid "A new run from the top"
msgstr "从最上层重新出发"

msgid "Skips the first %d depths"
msgstr "跳过前 %d 层"

msgid "Ember Altar"
msgstr "余烬祭坛"

msgid "Ember Edge"
msgstr "余烬之刃"

msgid "Your blade hits a quarter harder."
msgstr "武器伤害提高四分之一。"

msgid "Fleet Foot"
msgstr "疾足"

msgid "You move a sixth faster."
msgstr "移动速度提高六分之一。"

msgid "Ember Skin"
msgstr "余烬之肤"

msgid "Hits take a fifth less of your health."
msgstr "受到的伤害减少五分之一。"

msgid "Second Wind"
msgstr "重振"

msgid "Restore 40 health."
msgstr "恢复 40 点生命。"

msgid "Ember Tithe"
msgstr "余烬什一"

msgid "Find 15g in the ashes."
msgstr "在灰烬中找到 15 金币。"

msgid "Ember-Blessed"
msgstr "余烬眷顾"

msgid "Take five boons in one run."
msgstr "在一轮中获得五项祝福。"

msgid "Heart of Embers"
msgstr "余烬之心"

msgid "Your blade hits two fifths harder. Found by those who reached depth 10."
msgstr "武器伤害提高五分之二。只有到过第 10 层的人才能找到。"

msgid "Slayer's Fury"
msgstr "屠戮者之怒"

msgid "You hit a tenth harder and move a tenth faster. Found by slayers."
msgstr "伤害和移动速度各提高十分之一。只有屠戮者才能找到。"

msgid "Depth Reached"
msgstr "到达层数"

msgid "Most Creatures in a Run"
msgstr "单次冒险最多击败"

msgid "Ember Rampage"
msgstr "余烬横扫"

msgid "Defeat 15 creatures of the depths in a single run."
msgstr "在一次冒险中击败 15 只深渊生物。"

msgid "Ember Forge"
msgstr "余烬熔炉"

msgid "Tempered Blade"
msgstr "淬火之刃"

msgid "Every strike hits a tenth harder per level."
msgstr "每级让每次攻击的伤害提高一成。"

msgid "Hardened Hide"
msgstr "硬化皮甲"

msgid "Every blow hurts a tenth less per level."
msgstr "每级让受到的伤害减少一成。"

msgid "Fleet Boots"
msgstr "轻捷之靴"

msgid "Lighter steps: a little faster per level."
msgstr "脚步更轻：每级移动快一些。"

msgid "Ember Brand"
msgstr "余烬烙印"

msgid "An ember core forged into the blade: strikes hit a fifth harder."
msgstr "把余烬之核锻进刀刃：攻击伤害提高两成。"

msgid "Fully Forged"
msgstr "百炼成钢"

msgid "Raise every upgrade of the Ember Forge to its last level."
msgstr "把余烬熔炉的所有强化升到满级。"

msgid "Hearthblood"
msgstr "炉心之血"

msgid "The forge's warmth in your veins: 20 more health per level."
msgstr "熔炉的热流涌入血脉：每级生命上限 +20。"

msgid "Ember Vigor"
msgstr "余烬活力"

msgid "25 more health for the run, and it comes filled."
msgstr "本次冒险生命上限 +25，并立即补满这部分。"

msgid "Make a Pact?"
msgstr "立下誓约？"

msgid "No Pact"
msgstr "不立誓约"

msgid "The depths as they are"
msgstr "深渊一如往常"

msgid "Pact of Ash"
msgstr "灰烬之约"

msgid "Foes hit a third harder, and drop half again as much."
msgstr "敌人的攻击强三成，掉落也多五成。"

msgid "Pact of Glass"
msgstr "琉璃之约"

msgid "Your blade hits half again as hard, with 40 less health for the run."
msgstr "本次冒险攻击伤害提高五成，但生命上限 -40。"

msgid "Pact of Greed"
msgstr "贪婪之约"

msgid "Foes drop twice as much, and your blade hits a quarter softer."
msgstr "敌人掉落翻倍，但你的攻击伤害降低两成五。"

msgid "Unbroken Glass"
msgstr "琉璃未碎"

msgid "Reach depth 10 under the Pact of Glass."
msgstr "在琉璃之约下到达第 10 层。"

msgid "Ember Warden"
msgstr "余烬守卫"

msgid "%s guards this depth"
msgstr "%s 镇守着这一层"

msgid "Warden Felled"
msgstr "守卫陨落"

msgid "Defeat an Ember Warden, the guardian of every fifth depth."
msgstr "击败余烬守卫——每隔五层镇守深渊的守护者。"

msgid "Warden's Bane"
msgstr "守卫克星"

msgid "Defeat the Ember Warden 10 times, counting every run."
msgstr "击败余烬守卫 10 次，所有冒险累计。"

msgid "Hulking %s"
msgstr "巨型%s"

msgid "Swift %s"
msgstr "迅捷%s"

msgid "Searing %s"
msgstr "灼热%s"

msgid "Elite Hunter"
msgstr "精英猎手"

msgid "Defeat 10 elite creatures, counting every run."
msgstr "击败 10 只精英怪物，所有冒险累计。"
