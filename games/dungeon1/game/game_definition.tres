[ext_resource type="Resource" path="res://gamebase/core/input/controls/move_down.tres" id="7_move_down"]
[ext_resource type="Resource" path="res://gamebase/core/input/controls/move_left.tres" id="8_move_left"]
[ext_resource type="Resource" path="res://gamebase/core/input/controls/move_right.tres" id="9_move_right"]

[sub_resource type="Resource" id="Control_attack"]
script = ExtResource("3_control")
action = &"attack"
display_name = "Attack"
key = 74
secondary_key = 32
gamepad_button = 2

[sub_resource type="Resource" id="Control_drink"]
script = ExtResource("3_control")
action = &"drink_potion"
display_name = "Drink Potion"
key = 81
gamepad_button = 3

[sub_resource type="Resource" id="Control_next_item"]
script = ExtResource("3_control")
action = &"next_item"
display_name = "Next Item"
key = 4194306
gamepad_button = 10

[sub_resource type="Resource" id="Calendar"]
script = ExtResource("5_calendar")
season_names = PackedStringArray("Day")
days_per_season = 1000
real_seconds_per_game_minute = 0.0
collapse_minute = -1

[resource]
script = ExtResource("1_definition")
content = [ExtResource("2_content")]
start_location_id = &"camp"
home_location_id = &"camp"
home_spawn_id = &"camp_start"
defeat_money_loss_percent = 25
calendar = SubResource("Calendar")
start_day = 1
start_minute_of_day = 480
world_seed = 0
start_items = Dictionary[StringName, int]({
&"rusty_sword": 1,
&"health_potion": 2
})
event_cues = Dictionary[StringName, StringName]({
&"CombatEvents.attack_swung": &"sfx_swing",
&"CombatEvents.enemy_hurt": &"sfx_hit",
&"CombatEvents.enemy_defeated": &"sfx_enemy_defeated",
&"CombatEvents.player_hurt": &"sfx_hurt",
&"ShopState.purchase_completed": &"sfx_purchase",
&"ShopState.sale_completed": &"sfx_sale"
})
start_money = 30
start_hotbar = Array[StringName]([&"rusty_sword", &"health_potion"])
controls = Array[Resource]([ExtResource("6_move_up"), ExtResource("7_move_down"), ExtResource("8_move_left"), ExtResource("9_move_right"), ExtResource("4_interact"), SubResource("Control_attack"), SubResource("Control_drink"), SubResource("Control_next_item")])
