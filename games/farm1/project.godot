CraftingState="*res://gamebase/modules/items/crafting/crafting_service.gd"
StorageState="*res://gamebase/modules/items/storage/storage_service.gd"
BuildingState="*res://gamebase/modules/items/building/building_placement_service.gd"
CombatEvents="*res://gamebase/modules/combat/combat_events.gd"
Skills="*res://gamebase/modules/skills/skill_manager.gd"
LifesimEvents="*res://gamebase/modules/lifesim/lifesim_events.gd"
EventState="*res://gamebase/modules/lifesim/calendar/calendar_event_manager.gd"
ShippingState="*res://gamebase/modules/lifesim/economy/shipping_service.gd"
FarmExpansionState="*res://gamebase/modules/lifesim/expansions/farm_expansion_service.gd"
MineState="*res://gamebase/modules/lifesim/mining/mine_run_state.gd"
AnimalState="*res://gamebase/modules/lifesim/animals/animal_ownership_service.gd"
FishingState="*res://gamebase/modules/lifesim/fishing/fishing_service.gd"
NpcSocialEvents="*res://gamebase/modules/npc_social/npc_social_events.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
RelationshipState="*res://gamebase/modules/npc_social/npc/relationship_manager.gd"
HeartEvents="*res://gamebase/modules/npc_social/npc/heart_event_service.gd"
NpcMemory="*res://gamebase/modules/npc_social/npc/npc_memory_store.gd"
NpcContext="*res://gamebase/modules/npc_social/npc/npc_context_service.gd"
ConversationService="*res://gamebase/modules/npc_social/npc/conversation_service.gd"
ProgressionEvents="*res://gamebase/modules/progression/progression_events.gd"
QuestState="*res://gamebase/modules/progression/quests/quest_manager.gd"
MailState="*res://gamebase/modules/progression/mail/mail_service.gd"
UpgradeState="*res://gamebase/modules/progression/upgrades/tool_upgrade_service.gd"
CollectionState="*res://gamebase/modules/progression/collections/collection_service.gd"
CollectionMilestones="*res://gamebase/modules/progression/collections/collection_milestone_service.gd"
DailyContractState="*res://gamebase/modules/progression/contracts/daily_contract_service.gd"
TownProjects="*res://gamebase/modules/progression/projects/town_project_service.gd"
WorldTravel="*res://gamebase/core/world/world_travel.gd"
GameAudio="*res://gamebase/core/audio/game_audio_service.gd"
SaveManager="*res://gamebase/core/save/game_save_manager.gd"
AutoSave="*res://gamebase/core/save/auto_save_service.gd"
GameSession="*res://gamebase/core/session/game_session.gd"
Playthrough="*res://gamebase/core/playthrough/playthrough_service.gd"
MiniGameHost="*res://gamebase/core/minigames/minigame_host.gd"
GameTriggers="*res://gamebase/core/rules/game_triggers.gd"
GameDiagnostics="*res://gamebase/core/diagnostics/game_diagnostics.gd"
SupportBundle="*res://gamebase/core/diagnostics/support_bundle_service.gd"

[debug]

file_logging/log_path="user://logs/farm1.log"
gdscript/warnings/untyped_declaration=2
settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gut/plugin.cfg")

[gamebase]

game_definition="res://game/game_definition.tres"

[gui]

theme/custom="res://game/ui/game_theme.tres"

