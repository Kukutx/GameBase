; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Farm1"
config/description="A farming life-sim on GameBase"
config/version="0.1.0"
run/main_scene="res://gamebase/core/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Transition="*res://gamebase/core/world/scene_transition.gd"
GameSettings="*res://gamebase/core/settings/game_settings.gd"
InputPrompts="*res://gamebase/core/input/input_prompt_service.gd"
InputLock="*res://gamebase/core/input/input_lock.gd"
GameEvents="*res://gamebase/core/events/game_events.gd"
GameRules="*res://gamebase/core/rules/game_rules.gd"
GameStats="*res://gamebase/core/stats/game_stats.gd"
GameRandom="*res://gamebase/core/random/game_random.gd"
WorldClock="*res://gamebase/core/time/game_clock.gd"
WeatherState="*res://gamebase/core/time/weather_system.gd"
ContentDB="*res://gamebase/core/content/content_registry.gd"
GameModules="*res://gamebase/core/modules/game_modules.gd"
PlayerState="*res://gamebase/core/player/player_state.gd"
WorldState="*res://gamebase/core/world/world_state.gd"
GameProfile="*res://gamebase/core/profile/game_profile.gd"
ItemsEvents="*res://gamebase/modules/items/items_events.gd"
