[internationalization]

locale/translations=PackedStringArray("res://gamebase/core/i18n/core.zh_CN.po", "res://gamebase/modules/combat/i18n/combat.zh_CN.po", "res://gamebase/modules/items/i18n/items.zh_CN.po", "res://gamebase/modules/lifesim/i18n/lifesim.zh_CN.po", "res://gamebase/modules/npc_social/i18n/npc_social.zh_CN.po", "res://gamebase/modules/progression/i18n/progression.zh_CN.po", "res://gamebase/modules/skills/i18n/skills.zh_CN.po", "res://game/i18n/ui.zh_CN.po")
