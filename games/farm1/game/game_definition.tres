&"storm": 0.02,
&"rain": 0.1
})

[sub_resource type="Resource" id="Calendar"]
script = ExtResource("9_calendar")
season_names = PackedStringArray("Spring", "Summer", "Autumn", "Winter")
days_per_season = 28
days_per_week = 7
real_seconds_per_game_minute = 0.7
night_starts_at = 1200
night_ends_at = 360
wake_minute = 360
collapse_minute = 120

[resource]
script = ExtResource("1_definition")
content = [ExtResource("2_content")]
start_location_id = &"starter_town"
home_location_id = &"player_home"
home_spawn_id = &"from_town"
defeat_money_loss_percent = 10
calendar = SubResource("Calendar")
start_day = 1
start_minute_of_day = 480
world_seed = 93017
weather_odds = Array[ExtResource("8_weather_odds")]([SubResource("Weather_spring"), SubResource("Weather_summer"), SubResource("Weather_autumn"), SubResource("Weather_winter")])
clear_weather_id = &"clear"
start_items = Dictionary[StringName, int]({
&"hoe": 1,
&"watering_can": 1,
&"pickaxe": 1,
&"rusty_sword": 1,
&"fishing_rod": 1,
&"turnip_seeds": 10,
&"hay": 20
})
event_cues = Dictionary[StringName, StringName]({
&"ItemsEvents.item_foraged": &"sfx_pickup",
&"LifesimEvents.crop_harvested": &"sfx_harvest",
&"NpcSocialEvents.gift_given": &"sfx_gift",
&"LifesimEvents.animal_product_collected": &"sfx_pickup",
&"LifesimEvents.fish_caught": &"sfx_fish_caught",
&"LifesimEvents.resource_mined": &"sfx_resource_mined",
&"CombatEvents.enemy_defeated": &"sfx_enemy_defeated",
&"LifesimEvents.item_processed": &"sfx_processing_complete",
&"ProgressionEvents.tool_upgraded": &"sfx_tool_upgraded",
&"CombatEvents.attack_swung": &"sfx_swing",
&"CombatEvents.enemy_hurt": &"sfx_hit",
&"CombatEvents.player_hurt": &"sfx_hurt",
&"ShopState.purchase_completed": &"sfx_purchase",
&"ShopState.sale_completed": &"sfx_sale"
})
start_money = 500
start_hotbar = Array[StringName]([&"hoe", &"watering_can", &"pickaxe", &"rusty_sword", &"turnip_seeds", &"fishing_rod", &"berry"])
controls = Array[Resource]([ExtResource("10_move_up"), ExtResource("11_move_down"), ExtResource("12_move_left"), ExtResource("13_move_right"), ExtResource("5_interact"), SubResource("Control_use_tool"), SubResource("Control_give_gift"), SubResource("Control_remove_building"), SubResource("Control_open_menu"), ExtResource("6_quick_save"), ExtResource("7_quick_load"), SubResource("Control_hotbar_prev"), SubResource("Control_hotbar_next")])
