[sub_resource type="Resource" id="Control_use_tool"]
script = ExtResource("4_control")
action = &"use_tool"
display_name = "Use Tool / Item"
key = 70
gamepad_button = 2

[sub_resource type="Resource" id="Control_give_gift"]
script = ExtResource("4_control")
action = &"give_gift"
display_name = "Give Gift"
key = 71
gamepad_button = 3

[sub_resource type="Resource" id="Control_remove_building"]
script = ExtResource("4_control")
action = &"remove_building"
display_name = "Pack Building"
key = 82
gamepad_button = 10

[sub_resource type="Resource" id="Control_open_menu"]
script = ExtResource("4_control")
action = &"open_menu"
display_name = "Open Menu"
key = 73
gamepad_button = 6

[sub_resource type="Resource" id="Control_hotbar_prev"]
script = ExtResource("4_control")
action = &"hotbar_prev"
rebindable = false
gamepad_axis = 4

[sub_resource type="Resource" id="Control_hotbar_next"]
script = ExtResource("4_control")
action = &"hotbar_next"
rebindable = false
gamepad_axis = 5

[sub_resource type="Resource" id="Weather_spring"]
script = ExtResource("8_weather_odds")
season = "Spring"
chances = Dictionary[StringName, float]({
&"storm": 0.05,
&"rain": 0.25
})

[sub_resource type="Resource" id="Weather_summer"]
script = ExtResource("8_weather_odds")
season = "Summer"
chances = Dictionary[StringName, float]({
&"storm": 0.04,
&"rain": 0.12
})

[sub_resource type="Resource" id="Weather_autumn"]
script = ExtResource("8_weather_odds")
season = "Autumn"
