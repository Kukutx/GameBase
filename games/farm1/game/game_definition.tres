[resource]
script = ExtResource("1_definition")
content = [ExtResource("2_content")]
start_location_id = &"starter_town"
home_location_id = &"player_home"
home_spawn_id = &"from_town"
start_day = 1
start_minute_of_day = 480
world_seed = 93017
start_items = Dictionary[StringName, int]({
&"hoe": 1,
&"watering_can": 1,
&"pickaxe": 1,
&"rusty_sword": 1,
&"fishing_rod": 1,
&"turnip_seeds": 10,
&"hay": 20
})
event_cues = Dictionary[StringName, StringName]({
&"ItemsEvents.item_foraged": &"sfx_pickup",
&"LifesimEvents.crop_harvested": &"sfx_harvest",
&"NpcSocialEvents.gift_given": &"sfx_gift",
&"LifesimEvents.animal_product_collected": &"sfx_pickup",
&"LifesimEvents.fish_caught": &"sfx_fish_caught",
&"LifesimEvents.resource_mined": &"sfx_resource_mined",
&"CombatEvents.enemy_defeated": &"sfx_enemy_defeated",
&"LifesimEvents.item_processed": &"sfx_processing_complete",
&"ProgressionEvents.tool_upgraded": &"sfx_tool_upgraded"
})
start_money = 500
start_hotbar = Array[StringName]([&"hoe", &"watering_can", &"pickaxe", &"rusty_sword", &"turnip_seeds", &"fishing_rod", &"berry"])
ui_theme = ExtResource("3_theme")
controls = Array[Resource]([SubResource("Control_move_up"), SubResource("Control_move_down"), SubResource("Control_move_left"), SubResource("Control_move_right"), ExtResource("5_interact"), SubResource("Control_use_tool"), SubResource("Control_give_gift"), SubResource("Control_remove_building"), SubResource("Control_open_menu"), ExtResource("6_quick_save"), ExtResource("7_quick_load"), SubResource("Control_hotbar_prev"), SubResource("Control_hotbar_next")])
