[gd_resource type="Resource" script_class="QuestData" format=3]

[ext_resource type="Script" path="res://gamebase/modules/progression/quests/quest_data.gd" id="1_quest"]
[ext_resource type="Script" path="res://gamebase/modules/progression/quests/quest_objective.gd" id="2_objective"]

[sub_resource type="Resource" id="Resource_objective"]
script = ExtResource("2_objective")
event = &"LifesimEvents.resource_mined"
condition = "EVENT_ARG mining_node_id stone_rock"
