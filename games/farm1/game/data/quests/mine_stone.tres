required_amount = 2

[resource]
script = ExtResource("1_quest")
id = &"mine_stone"
title = "Into the Mine"
description = "Break a stone rock in the Old Mine."
objectives = [SubResource("Resource_objective")]
reward_money = 150
next_quest_id = &"defeat_green_slime"
