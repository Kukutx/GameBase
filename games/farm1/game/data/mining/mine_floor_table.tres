[sub_resource type="Resource" id="chests"]
script = ExtResource("6_chests")
loot = SubResource("chest_loot")
chance = 0.2
from_level = 2
hoard = SubResource("hoard_loot")
hoard_name = "Royal Hoard"

[resource]
script = ExtResource("1_table")
default_rock_id = &"stone_rock"
rock_tiers = Array[ExtResource("2_rock")]([SubResource("rock_iridium_rock"), SubResource("rock_gold_rock"), SubResource("rock_iron_rock"), SubResource("rock_copper_rock")])
enemy_tiers = Array[ExtResource("3_enemy")]([SubResource("enemy_green_slime"), SubResource("enemy_cave_slime"), SubResource("enemy_blue_slime"), SubResource("enemy_spitting_slime"), SubResource("enemy_red_slime"), SubResource("enemy_shadow_slime"), SubResource("enemy_void_slime"), SubResource("enemy_ancient_slime"), SubResource("enemy_slime_king"), SubResource("enemy_void_monarch")])
elite_odds = SubResource("elite_odds")
hazards = SubResource("hazards")
chests = SubResource("chests")
