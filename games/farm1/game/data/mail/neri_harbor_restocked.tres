[gd_resource type="Resource" script_class="MailData" load_steps=2 format=3]

[ext_resource type="Script" path="res://gamebase/modules/progression/mail/mail_data.gd" id="1_mail"]

[resource]
script = ExtResource("1_mail")
id = &"neri_harbor_restocked"
sender_npc_id = &"neri"
subject = "The shelves are full again"
body = "Harbor stores finally look prepared instead of hopeful. That means fewer bad choices when the weather turns. I saved you a bowl from the first proper meal we cooked after restocking. — Neri"
condition = "PROJECT_COMPLETED harbor_supply_drive"
reward_items = {"fish_soup": 1}
