[resource]
script = ExtResource("1_profile")
id = &"rowan"
display_name = "Rowan"
role = "Riverside carpenter"
background = "Rowan repairs Riverside's bridge, sheds, and old wooden waterworks. He knows the roads between towns and hears plenty of travelers' stories while working."
personality = "Steady, dry-humored, reliable, slightly skeptical of shortcuts. Appreciates practical help and well-made things."
speaking_style = "Brief and grounded. Often compares problems to woodwork, tools, bridges, or maintenance."
home_location_id = &"riverside_town"
default_location_id = &"riverside_town"
birthday_season = "Spring"
birthday_day = 21
ai_enabled = true
dialogue_titles_by_hearts = {0: "start", 2: "friend_2", 4: "friend_4", 6: "friend_6", 8: "friend_8", 10: "friend_10"}
visual_strip_root = "res://game/art/licensed/craftpix_roguelike/character3"
schedule_entries = Array[ExtResource("2_entry")]([SubResource("Schedule_morning"), SubResource("Schedule_bridge"), SubResource("Schedule_lunch"), SubResource("Schedule_evening"), SubResource("Schedule_storm"), SubResource("Schedule_festival_spring_seed_fair"), SubResource("Schedule_festival_summer_river_fair"), SubResource("Schedule_festival_fall_harbor_derby"), SubResource("Schedule_festival_winter_lantern_night")])
loved_items = Array[StringName]([&"field_snack"])
liked_items = Array[StringName]([&"wood", &"potato"])
liked_tags = PackedStringArray("crafted", "crop")
