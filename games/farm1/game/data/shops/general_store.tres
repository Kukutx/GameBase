[gd_resource type="Resource" script_class="ShopData" load_steps=8 format=3]

[ext_resource type="Script" path="res://tiamat/modules/items/shop/shop_data.gd" id="1_shop"]
[ext_resource type="Script" path="res://tiamat/modules/items/shop/shop_offer.gd" id="2_offer"]
[ext_resource type="Script" path="res://tiamat/modules/lifesim/animals/animal_offer.gd" id="3_animal"]
[ext_resource type="Script" path="res://tiamat/modules/items/shop/shop_listing.gd" id="4_listing"]

[sub_resource type="Resource" id="Offer_chicken"]
script = ExtResource("3_animal")
animal_id = &"chicken"

[sub_resource type="Resource" id="Offer_cow"]
script = ExtResource("3_animal")
animal_id = &"cow"

[sub_resource type="Resource" id="Offer_pig"]
script = ExtResource("3_animal")
animal_id = &"pig"

[sub_resource type="Resource" id="Listing_copper_ore"]
script = ExtResource("4_listing")
item_id = &"copper_ore"
price = 100
condition = "PROJECT_COMPLETED riverside_workshop_fund"

[resource]
script = ExtResource("1_shop")
id = &"general_store"
display_name = "Village General Store"
stock = {"berry": 45, "hay": 20, "fishing_rod": 300, "pickaxe": 600, "rusty_sword": 500, "slingshot": 900}
seasonal_stock = {"Spring": {"turnip_seeds": 20, "carrot_seeds": 30, "potato_seeds": 40}, "Summer": {"tomato_seeds": 45}, "Autumn": {"carrot_seeds": 30, "pumpkin_seeds": 90}, "Winter": {"frostroot_seeds": 55}}
listings = Array[ExtResource("4_listing")]([SubResource("Listing_copper_ore")])
offers = Array[ExtResource("2_offer")]([SubResource("Offer_chicken"), SubResource("Offer_cow"), SubResource("Offer_pig")])
