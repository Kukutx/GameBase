; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Iron Banners"
config/description="Lead your banners in grid tactics and field battles."
config/version="0.1.0"
run/main_scene="res://gamebase/core/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[autoload]

Transition="*res://gamebase/core/world/scene_transition.gd"
GameSettings="*res://gamebase/core/settings/game_settings.gd"
InputPrompts="*res://gamebase/core/input/input_prompt_service.gd"
InputLock="*res://gamebase/core/input/input_lock.gd"
GameEvents="*res://gamebase/core/events/game_events.gd"
GameRules="*res://gamebase/core/rules/game_rules.gd"
GameStats="*res://gamebase/core/stats/game_stats.gd"
GameRandom="*res://gamebase/core/random/game_random.gd"
WorldClock="*res://gamebase/core/time/game_clock.gd"
WeatherState="*res://gamebase/core/time/weather_system.gd"
ContentDB="*res://gamebase/core/content/content_registry.gd"
GameModules="*res://gamebase/core/modules/game_modules.gd"
Vitals="*res://gamebase/core/player/player_vitals.gd"
WorldState="*res://gamebase/core/world/world_state.gd"
GameProfile="*res://gamebase/core/profile/game_profile.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
Dialogue="*res://gamebase/modules/dialogue/dialogue_service.gd"
RtsEvents="*res://gamebase/modules/rts/rts_events.gd"
TacticsEvents="*res://gamebase/modules/tactics/tactics_events.gd"
WorldTravel="*res://gamebase/core/world/world_travel.gd"
GameAudio="*res://gamebase/core/audio/game_audio_service.gd"
SaveManager="*res://gamebase/core/save/game_save_manager.gd"
AutoSave="*res://gamebase/core/save/auto_save_service.gd"
GameSession="*res://gamebase/core/session/game_session.gd"
Playthrough="*res://gamebase/core/playthrough/playthrough_service.gd"
MiniGameHost="*res://gamebase/core/minigames/minigame_host.gd"
GameTriggers="*res://gamebase/core/rules/game_triggers.gd"
GameDiagnostics="*res://gamebase/core/diagnostics/game_diagnostics.gd"
SupportBundle="*res://gamebase/core/diagnostics/support_bundle_service.gd"

[debug]

file_logging/log_path="user://logs/strategy1.log"
settings/gdscript/always_track_call_stacks=true
gdscript/warnings/untyped_declaration=2

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gut/plugin.cfg")

[gamebase]

game_definition="res://game/game_definition.tres"

[gui]

theme/custom="res://gamebase/core/ui/default_theme.tres"

