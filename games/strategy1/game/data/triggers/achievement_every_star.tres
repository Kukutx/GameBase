condition = "MINIGAME_STARS ford_battle 3, MINIGAME_STARS mill_battle 3, MINIGAME_STARS pass_battle 3, MINIGAME_STARS camp_battle 3"
actions = PackedStringArray("UNLOCK_ACHIEVEMENT every_star")
