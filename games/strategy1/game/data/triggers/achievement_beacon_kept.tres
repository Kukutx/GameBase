[gd_resource type="Resource" script_class="TriggerData" format=3]

[ext_resource type="Script" path="res://tiamat/core/rules/trigger_data.gd" id="1_trigger"]

[resource]
script = ExtResource("1_trigger")
id = &"achievement_beacon_kept"
event = &"TacticsEvents.battle_ended"
condition = "EVENT_ARG battle_map_id watchtower, EVENT_ARG won true"
actions = PackedStringArray("UNLOCK_ACHIEVEMENT beacon_kept")
