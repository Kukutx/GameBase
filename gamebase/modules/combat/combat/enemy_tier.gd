class_name EnemyTier
extends Resource

## An enemy, by content id, that a place generated by depth (a mine's floors,
## a dungeon's depths) spawns from `minimum_depth` on.

@export var enemy_id: StringName
@export_range(1, 9999, 1) var minimum_depth := 1

## The enemy of the deepest of `tiers` that `depth` reaches (the first such
## tier when several start there), or "" when it reaches none.
static func deepest(tiers: Array[EnemyTier], depth: int) -> StringName:
	var result := StringName()
	var best := 0
	for tier: EnemyTier in tiers:
		if tier != null and tier.minimum_depth <= depth and tier.minimum_depth > best:
			best = tier.minimum_depth
			result = tier.enemy_id
	return result

## The enemies of every one of `tiers` that `depth` reaches, in their order.
static func reached(tiers: Array[EnemyTier], depth: int) -> Array[StringName]:
	var result: Array[StringName] = []
	for tier: EnemyTier in tiers:
		if tier != null and tier.minimum_depth <= depth:
			result.append(tier.enemy_id)
	return result

## For a `find_problems()`: each of `tiers` that names no enemy of `registry`.
static func find_problems(tiers: Array[EnemyTier], registry: ContentRegistry) -> PackedStringArray:
	var problems := PackedStringArray()
	for tier: EnemyTier in tiers:
		if tier == null or not registry.has_entry(EnemyData.KIND, tier.enemy_id):
			problems.append("enemy tier '%s' is not an enemy" % (tier.enemy_id if tier != null else &""))
	return problems
