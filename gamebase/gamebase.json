{
  "name": "gamebase",
  "version": "0.1.0",
  "include": ["gamebase/", "addons/dialogue_manager/", "addons/gut/", "tools/gamebase_sync.js", "tools/check_layers.js"],
  "exclude": ["gamebase/templates/"],
  "modules_dir": "gamebase/modules/",
  "modules": {
    "combat": { "requires": ["items"] },
    "items": { "requires": ["lifesim", "progression"] },
    "lifesim": { "requires": ["combat", "items", "progression"] },
    "npc_social": { "requires": ["items", "lifesim", "progression"] },
    "progression": { "requires": ["items", "lifesim", "npc_social"] }
  }
}
