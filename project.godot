[internationalization]

locale/translations=PackedStringArray("res://game/i18n/ui.zh_CN.po")
locale/translations_pot_files=PackedStringArray("res://game/dialogue/intro.dialogue", "res://game/dialogue/neri.dialogue", "res://game/dialogue/rowan.dialogue")

[layer_names]

2d_physics/layer_1="Environment"
2d_physics/layer_2="Player"
2d_physics/layer_3="Enemy"
2d_physics/layer_4="Navigation Obstacle"
2d_physics/layer_5="Interactable"

[navigation]

2d/use_edge_connections=false
2d/default_edge_connection_margin=24.0
2d/default_link_connection_radius=24.0

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=3
