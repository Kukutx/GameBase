; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="GameBase"
run/main_scene="res://game/ui/title_screen.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Transition="*res://game/core/world/scene_transition.gd"
DialogueManager="*res://addons/dialogue_manager/dialogue_manager.gd"
GameSettings="*res://game/core/settings/game_settings.gd"
InputPrompts="*res://game/core/input/input_prompt_service.gd"
GameEvents="*res://game/core/events/game_events.gd"
WorldClock="*res://game/core/time/game_clock.gd"
WeatherState="*res://game/core/time/weather_system.gd"
ContentDB="*res://game/core/content/content_database.gd"
ItemCatalog="*res://game/core/items/item_catalog.gd"
CropCatalog="*res://game/core/farming/crop_catalog.gd"
InventoryState="*res://game/core/items/inventory_store.gd"
PlayerState="*res://game/core/player/player_state.gd"
WorldState="*res://game/core/world/world_state.gd"
EventState="*res://game/core/events/calendar_event_manager.gd"
NpcCatalog="*res://game/core/npc/npc_catalog.gd"
RelationshipState="*res://game/core/npc/relationship_manager.gd"
HeartEvents="*res://game/core/npc/heart_event_service.gd"
QuestState="*res://game/core/quests/quest_manager.gd"
MailState="*res://game/core/mail/mail_service.gd"
Skills="*res://game/core/skills/skill_manager.gd"
BuffState="*res://game/core/buffs/buff_service.gd"
NpcMemory="*res://game/core/npc/npc_memory_store.gd"
NpcContext="*res://game/core/npc/npc_context_service.gd"
ShopState="*res://game/core/shop/shop_service.gd"
CraftingState="*res://game/core/crafting/crafting_service.gd"
UpgradeState="*res://game/core/upgrades/tool_upgrade_service.gd"
ShippingState="*res://game/core/economy/shipping_service.gd"
CollectionState="*res://game/core/collections/collection_service.gd"
CollectionMilestones="*res://game/core/collections/collection_milestone_service.gd"
DailyContractState="*res://game/core/contracts/daily_contract_service.gd"
TownProjects="*res://game/core/projects/town_project_service.gd"
FarmExpansionState="*res://game/core/expansions/farm_expansion_service.gd"
MineState="*res://game/core/mining/mine_run_state.gd"
StorageState="*res://game/core/storage/storage_service.gd"
AnimalState="*res://game/core/animals/animal_ownership_service.gd"
BuildingState="*res://game/core/building/building_placement_service.gd"
FishingState="*res://game/core/fishing/fishing_service.gd"
ConversationService="*res://game/core/dialogue/conversation_service.gd"
LocationCatalog="*res://game/core/world/world_location_catalog.gd"
WorldTravel="*res://game/core/world/world_travel.gd"
SaveManager="*res://game/core/save/game_save_manager.gd"
AutoSave="*res://game/core/save/auto_save_service.gd"
GameSession="*res://game/core/session/game_session.gd"
GameDiagnostics="*res://game/core/diagnostics/game_diagnostics.gd"

[debug]

file_logging/enable_file_logging.pc=true
file_logging/log_path="user://logs/gamebase.log"
file_logging/max_log_files=5
settings/gdscript/always_track_call_stacks=true

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_height"

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogue_manager/plugin.cfg", "res://addons/gut/plugin.cfg")

