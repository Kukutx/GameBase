{
  "schemaVersion": 1,
  "plugins": {
    "devmate.godot": {
      "projectSubpath": ".",
      "preset": "Web",
      "outputPath": "build/web/index.html",
      "mode": "debug",
      "exportMode": "release",
      "exportOutputRoot": "build/exports",
      "exports": [
        {
          "preset": "Windows Desktop",
          "outputPath": "build/windows/GameBase.exe"
        },
        {
          "preset": "Linux",
          "outputPath": "build/linux/GameBase.x86_64"
        },
        {
          "preset": "Web",
          "outputPath": "build/web/index.html"
        }
      ],
      "scenarios": []
    },
    "devmate.godot-advanced": {
      "projectSubpath": ".",
      "scenarios": [
        {
          "id": "unit-tests",
          "kind": "tests",
          "framework": "gut",
          "directories": [
            "test/unit"
          ],
          "includeSubdirectories": true,
          "reportPath": "artifacts/godot-tests/gut.xml"
        }
      ]
    }
  }
}
