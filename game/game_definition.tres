[gd_resource type="Resource" script_class="GameDefinition" format=3]

[ext_resource type="Script" path="res://gamebase/core/session/game_definition.gd" id="1_definition"]
[ext_resource type="Script" path="res://game/save/game_save_migrations.gd" id="2_migrations"]
[ext_resource type="Theme" path="res://game/ui/game_theme.tres" id="3_theme"]

[resource]
script = ExtResource("1_definition")
start_location_id = &"starter_town"
home_location_id = &"player_home"
home_spawn_id = &"from_town"
start_day = 1
start_minute_of_day = 480
world_seed = 93017
start_items = Dictionary[StringName, int]({
&"hoe": 1,
&"watering_can": 1,
&"pickaxe": 1,
&"rusty_sword": 1,
&"fishing_rod": 1,
&"turnip_seeds": 10,
&"hay": 20
})
event_cues = Dictionary[StringName, StringName]({
&"item_foraged": &"sfx_pickup",
&"crop_harvested": &"sfx_harvest",
&"gift_given": &"sfx_gift",
&"animal_product_collected": &"sfx_pickup",
&"fish_caught": &"sfx_fish_caught",
&"resource_mined": &"sfx_resource_mined",
&"enemy_defeated": &"sfx_enemy_defeated",
&"item_processed": &"sfx_processing_complete",
&"tool_upgraded": &"sfx_tool_upgraded"
})
start_money = 500
start_hotbar = Array[StringName]([&"hoe", &"watering_can", &"pickaxe", &"rusty_sword", &"turnip_seeds", &"fishing_rod", &"berry"])
save_migrations = ExtResource("2_migrations")
ui_theme = ExtResource("3_theme")
