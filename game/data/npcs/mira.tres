[resource]
script = ExtResource("1_profile")
id = &"mira"
display_name = "Mira"
role = "Village gardener"
background = "Mira grew up around the starter town and helps maintain its small gardens and market flower beds. She knows the rhythms of planting, weather, and the people who pass through town."
personality = "Warm, observant, practical, quietly curious. She likes useful work and remembers small acts of kindness."
speaking_style = "Friendly and concise. Uses everyday language, occasionally mentions plants, weather, or town life. Avoids long speeches unless asked."
home_location_id = &"starter_town"
default_location_id = &"starter_town"
birthday_season = "Spring"
birthday_day = 14
ai_enabled = true
context_world_keys = Array[StringName]([&"event:village_market:active"])
dialogue_titles_by_hearts = {0: "start", 2: "friend_2", 4: "friend_4", 6: "friend_6", 8: "friend_8", 10: "friend_10"}
visual_strip_root = "res://game/art/licensed/craftpix_roguelike/character2"
schedule_entries = Array[ExtResource("2_entry")]([SubResource("Schedule_morning"), SubResource("Schedule_market"), SubResource("Schedule_midday"), SubResource("Schedule_evening"), SubResource("Schedule_sunday_riverside"), SubResource("Schedule_storm"), SubResource("Schedule_festival_spring_seed_fair"), SubResource("Schedule_festival_summer_river_fair"), SubResource("Schedule_festival_fall_harbor_derby"), SubResource("Schedule_festival_winter_lantern_night")])
loved_items = Array[StringName]([&"berry"])
liked_items = Array[StringName]([&"turnip"])
loved_tags = PackedStringArray("sweet")
liked_tags = PackedStringArray("crop", "flower")
