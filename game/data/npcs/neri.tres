[resource]
script = ExtResource("1_profile")
id = &"neri"
display_name = "Neri"
role = "Harbor fishmonger"
background = "Neri grew up around Harbor Town's docks and now buys, sorts, and sells the morning catch. She knows tides, storms, fish seasons, and nearly every rumor carried in by boat."
personality = "Quick-witted, energetic, observant, competitive about fishing knowledge. Friendly to people who respect the sea and keep their word."
speaking_style = "Lively and concise. Uses harbor slang sparingly and often mentions tides, weather, catches, or boats."
home_location_id = &"harbor_town"
default_location_id = &"harbor_town"
birthday_season = "Summer"
birthday_day = 7
ai_enabled = true
dialogue_titles_by_hearts = {0: "start", 2: "friend_2", 4: "friend_4", 6: "friend_6", 8: "friend_8", 10: "friend_10"}
visual_strip_root = "res://game/art/licensed/craftpix_roguelike/character1"
visual_modulate = Color(0.72, 0.9, 1, 1)
schedule_entries = Array[ExtResource("2_entry")]([SubResource("Schedule_morning"), SubResource("Schedule_market"), SubResource("Schedule_afternoon"), SubResource("Schedule_evening"), SubResource("Schedule_storm"), SubResource("Schedule_festival_spring_seed_fair"), SubResource("Schedule_festival_summer_river_fair"), SubResource("Schedule_festival_fall_harbor_derby"), SubResource("Schedule_festival_winter_lantern_night")])
loved_items = Array[StringName]([&"mackerel"])
liked_items = Array[StringName]([&"sardine", &"river_trout"])
liked_tags = PackedStringArray("fish", "ocean")
