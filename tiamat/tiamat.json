{
  "addons": ["gut"],
  "android_permissions": ["vibrate"],
  "autoloads": {
    "before_modules": {
      "Transition": "res://tiamat/core/world/scene_transition.gd",
      "GameSettings": "res://tiamat/core/settings/game_settings.gd",
      "InputPrompts": "res://tiamat/core/input/input_prompt_service.gd",
      "InputLock": "res://tiamat/core/input/input_lock.gd",
      "GameEvents": "res://tiamat/core/events/game_events.gd",
      "GameRules": "res://tiamat/core/rules/game_rules.gd",
      "GameStats": "res://tiamat/core/stats/game_stats.gd",
      "GameRandom": "res://tiamat/core/random/game_random.gd",
      "WorldClock": "res://tiamat/core/time/game_clock.gd",
      "WeatherState": "res://tiamat/core/time/weather_system.gd",
      "ContentDB": "res://tiamat/core/content/content_registry.gd",
      "GameModules": "res://tiamat/core/modules/game_modules.gd",
      "Vitals": "res://tiamat/core/player/player_vitals.gd",
      "WorldState": "res://tiamat/core/world/world_state.gd",
      "GameProfile": "res://tiamat/core/profile/game_profile.gd"
    },
    "after_modules": {
      "WorldTravel": "res://tiamat/core/world/world_travel.gd",
      "GameAudio": "res://tiamat/core/audio/game_audio_service.gd",
      "SaveManager": "res://tiamat/core/save/game_save_manager.gd",
      "AutoSave": "res://tiamat/core/save/auto_save_service.gd",
      "GameSession": "res://tiamat/core/session/game_session.gd",
      "Playthrough": "res://tiamat/core/playthrough/playthrough_service.gd",
      "MiniGameHost": "res://tiamat/core/minigames/minigame_host.gd",
      "TouchControls": "res://tiamat/core/input/touch/touch_controls.gd",
      "GameTriggers": "res://tiamat/core/rules/game_triggers.gd",
      "GameDiagnostics": "res://tiamat/core/diagnostics/game_diagnostics.gd",
      "SupportBundle": "res://tiamat/core/diagnostics/support_bundle_service.gd"
    }
  },
  "modules": {
    "combat": {
      "requires": ["damage", "items"],
      "autoloads": {
        "CombatEvents": "res://tiamat/modules/combat/combat_events.gd",
        "PlayerDefeat": "res://tiamat/modules/combat/defeat/player_defeat_service.gd",
        "FightState": "res://tiamat/modules/combat/fight/fight_service.gd"
      }
    },
    "damage": {
      "requires": []
    },
    "dialogue": {
      "requires": [],
      "addons": ["dialogue_manager"],
      "autoloads": {
        "DialogueManager": "res://addons/dialogue_manager/dialogue_manager.gd",
        "Dialogue": "res://tiamat/modules/dialogue/dialogue_service.gd"
      }
    },
    "items": {
      "requires": [],
      "autoloads": {
        "ItemsEvents": "res://tiamat/modules/items/items_events.gd",
        "InventoryState": "res://tiamat/modules/items/items/inventory_store.gd",
        "Wallet": "res://tiamat/modules/items/wallet/wallet_service.gd",
        "Hotbar": "res://tiamat/modules/items/hotbar/hotbar_service.gd",
        "BuffState": "res://tiamat/modules/items/buffs/buff_service.gd",
        "ShopState": "res://tiamat/modules/items/shop/shop_service.gd",
        "CraftingState": "res://tiamat/modules/items/crafting/crafting_service.gd",
        "StorageState": "res://tiamat/modules/items/storage/storage_service.gd",
        "BuildingState": "res://tiamat/modules/items/building/building_placement_service.gd"
      }
    },
    "lifesim": {
      "requires": ["combat", "items", "skills"],
      "autoloads": {
        "LifesimEvents": "res://tiamat/modules/lifesim/lifesim_events.gd",
        "EventState": "res://tiamat/modules/lifesim/calendar/calendar_event_manager.gd",
        "ShippingState": "res://tiamat/modules/lifesim/economy/shipping_service.gd",
        "FarmExpansionState": "res://tiamat/modules/lifesim/expansions/farm_expansion_service.gd",
        "MineState": "res://tiamat/modules/lifesim/mining/mine_run_state.gd",
        "AnimalState": "res://tiamat/modules/lifesim/animals/animal_ownership_service.gd",
        "FishingState": "res://tiamat/modules/lifesim/fishing/fishing_service.gd",
        "LateNight": "res://tiamat/modules/lifesim/rest/late_night_service.gd",
        "CollectionState": "res://tiamat/modules/lifesim/collections/collection_service.gd",
        "CollectionMilestones": "res://tiamat/modules/lifesim/collections/collection_milestone_service.gd",
        "DailyContractState": "res://tiamat/modules/lifesim/contracts/daily_contract_service.gd"
      }
    },
    "npc_ai": {
      "requires": ["dialogue", "npc_social"],
      "addons": ["dialogue_manager"],
      "android_permissions": ["internet"],
      "autoloads": {
        "NpcAi": "res://tiamat/modules/npc_ai/ai/npc_ai_service.gd"
      }
    },
    "npc_social": {
      "requires": ["dialogue", "items"],
      "addons": ["dialogue_manager"],
      "autoloads": {
        "NpcSocialEvents": "res://tiamat/modules/npc_social/npc_social_events.gd",
        "RelationshipState": "res://tiamat/modules/npc_social/npc/relationship_manager.gd",
        "HeartEvents": "res://tiamat/modules/npc_social/npc/heart_event_service.gd",
        "NpcMemory": "res://tiamat/modules/npc_social/npc/npc_memory_store.gd",
        "NpcContext": "res://tiamat/modules/npc_social/npc/npc_context_service.gd",
        "ConversationService": "res://tiamat/modules/npc_social/npc/conversation_service.gd"
      }
    },
    "progression": {
      "requires": ["items", "npc_social", "skills"],
      "autoloads": {
        "ProgressionEvents": "res://tiamat/modules/progression/progression_events.gd",
        "QuestState": "res://tiamat/modules/progression/quests/quest_manager.gd",
        "MailState": "res://tiamat/modules/progression/mail/mail_service.gd",
        "UpgradeState": "res://tiamat/modules/progression/upgrades/tool_upgrade_service.gd",
        "TownProjects": "res://tiamat/modules/progression/projects/town_project_service.gd"
      }
    },
    "roguelite": {
      "requires": [],
      "autoloads": {
        "RunState": "res://tiamat/modules/roguelite/runs/run_service.gd"
      }
    },
    "rts": {
      "requires": ["damage"],
      "autoloads": {
        "RtsEvents": "res://tiamat/modules/rts/rts_events.gd"
      }
    },
    "skills": {
      "requires": [],
      "autoloads": {
        "Skills": "res://tiamat/modules/skills/skill_manager.gd"
      }
    },
    "tactics": {
      "requires": ["damage"],
      "autoloads": {
        "TacticsEvents": "res://tiamat/modules/tactics/tactics_events.gd"
      }
    }
  }
}
