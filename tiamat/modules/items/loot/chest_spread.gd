class_name ChestSpread
extends Resource

## Which floors of a place generated by depth hold a chest (`LootChest`), and
## what it holds: from `from_level` on, a floor holds one as often as `chance`
## says, of `loot` at the floor's level; and a guarded floor (one its place
## says a guardian holds) always holds the `hoard` while there is one. A place
## rolls it from a stream of the floor's own (`holds_chest()`), so the same
## floor holds the same chest, then makes it (`make()`) and fills it from that
## stream or leaves it to its key: Ember Depths' floors, and the lifesim
## mine's (`MineFloorTable.chests`).

const CHEST_SCENE := preload("res://tiamat/modules/items/loot/loot_chest.tscn")

## What an ordinary floor's chest holds; none without.
@export var loot: LootTable
## How often a floor from `from_level` on holds one.
@export_range(0.0, 1.0, 0.01) var chance := 0.3
## The first level a chest may stand on.
@export_range(0, 9999, 1, "or_greater") var from_level := 1
## What its prompt calls an ordinary chest.
@export var display_name := "Chest"
## What a guarded floor's chest holds; there always. None without.
@export var hoard: LootTable
## What its prompt calls the hoard.
@export var hoard_name := "Hoard"

## Whether a floor at `level` holds a chest, rolled from `rolls`; a guarded
## one always while there is a hoard.
func holds_chest(rolls: GameRandomStream, level: int, guarded := false) -> bool:
	if guarded and hoard != null:
		return true
	return loot != null and level >= from_level and rolls.randf() < chance

## A chest for a floor at `level`, empty until it is filled
## (`LootChest.fill()`) or opened: the hoard on a guarded floor while there
## is one.
func make(level: int, guarded := false) -> LootChest:
	var is_hoard := guarded and hoard != null
	var chest := CHEST_SCENE.instantiate() as LootChest
	chest.name = "Hoard" if is_hoard else "Chest"
	chest.display_name = hoard_name if is_hoard else display_name
	chest.loot = hoard if is_hoard else loot
	chest.level = level
	return chest

## Adds `way` (translated already) as a way to get what its chests may hold
## (`ItemSources`).
func add_ways(sources: ItemSources, way: String) -> void:
	for table: LootTable in [loot, hoard]:
		if table != null:
			table.add_ways(sources, way)

## What is wrong with its tables against `registry`'s items.
func find_problems(registry: ContentRegistry) -> PackedStringArray:
	var problems := PackedStringArray()
	if loot == null and hoard == null:
		problems.append("chest spread holds no loot table")
	for table: LootTable in [loot, hoard]:
		if table != null:
			for problem: String in table.find_problems(registry):
				problems.append("chest spread %s" % problem)
	return problems
