class_name EliteOdds
extends Resource

## How often the creatures of a place generated by depth (a mine's floors, a
## dungeon's depths) come in an elite form (`EliteData`): from `from_depth`
## on, `chance` there and `chance_per_depth` more each depth below, up to
## `max_chance`.

@export_range(1, 9999, 1) var from_depth := 3
@export_range(0.0, 1.0, 0.005) var chance := 0.05
@export_range(0.0, 1.0, 0.005) var chance_per_depth := 0.03
@export_range(0.0, 1.0, 0.005) var max_chance := 0.35

## The chance a creature at `depth` comes as an elite.
func get_chance(depth: int) -> float:
	if depth < from_depth:
		return 0.0
	return minf(chance + chance_per_depth * (depth - from_depth), max_chance)

## The elite form of a creature at `depth`, rolled from `rolls`
## (`EliteData.roll()`), or null.
func roll(rolls: GameRandomStream, depth: int) -> EliteData:
	return EliteData.roll(rolls, get_chance(depth))
