class_name HazardSpread
extends Resource

## The hazards of the ground (`Hazard`) that a place generated by depth spreads
## over its floor: Ember Depths' ember vents, the lifesim mine's
## (`MineFloorTable.hazards`). None above `from_depth`, one there and one more
## every `every` depths below, `most` at most (`count_at()`). `spread()` finds
## their places, `spacing` apart and from what already stands on the floor;
## `make()` makes each from `scene` (none: a plain `Hazard`), its damage
## raised by `damage_per_depth` for each depth below `from_depth`, laying
## `affliction_id` when it names one, and started a rolled share into its
## cycle, so hazards side by side flare in turn.

## The first depth that holds hazards.
@export_range(1, 9999, 1) var from_depth := 3
## How many depths below the last one more hazard comes.
@export_range(1, 999, 1) var every := 2
## The most hazards a floor holds.
@export_range(0, 32, 1) var most := 4
## How far apart hazards stand, and how far from what already stands there.
@export_range(8.0, 400.0, 1.0) var spacing := 56.0
## What each hazard is made from: a scene whose root is a `Hazard`, with its
## look, reach, damage and cycle; none: a plain one.
@export var scene: PackedScene
## The damage a hazard gains for each depth below `from_depth`.
@export_range(0.0, 50.0, 0.05) var damage_per_depth := 0.5
## What each hazard's flares lay on what they hurt (`Hazard.affliction_id`);
## empty, what its scene says.
@export var affliction_id: StringName

## How many hazards a floor at `depth` holds.
func count_at(depth: int) -> int:
	if depth < from_depth:
		return 0
	return mini(1 + (depth - from_depth) / every, most)

## The places of the hazards of a floor at `depth` in `area`, rolled from
## `rolls`: `spacing` apart and from each point of `taken`, where `accept`
## holds (given a point; none: anywhere). A hazard that finds no such place
## is left out.
func spread(rolls: GameRandomStream, depth: int, area: Rect2, taken := PackedVector2Array(), accept := Callable()) -> PackedVector2Array:
	var places := PackedVector2Array()
	var count := count_at(depth)
	if count == 0:
		return places
	var near := taken.duplicate()
	for point: Vector2 in rolls.scatter(area, count, spacing, taken, Vector2(8, 8), accept):
		if _is_clear(point, near) and (not accept.is_valid() or bool(accept.call(point))):
			places.append(point)
			near.append(point)
	return places

## A hazard for a floor at `depth`, `phase` (0 to 1) of the way into its
## cycle; null when `scene`'s root is not a `Hazard`.
func make(depth: int, phase := 0.0) -> Hazard:
	var hazard: Hazard
	if scene == null:
		hazard = Hazard.new()
	else:
		var node := scene.instantiate()
		hazard = node as Hazard
		if hazard == null:
			node.free()
			return null
	hazard.damage = mini(hazard.damage + roundi(damage_per_depth * maxi(depth - from_depth, 0)), 999)
	hazard.phase_seconds = clampf(phase, 0.0, 1.0) * hazard.get_cycle_seconds()
	if affliction_id != &"":
		hazard.affliction_id = affliction_id
	return hazard

## What is wrong with the spread, as readable problems: a scene whose root is
## not a `Hazard`, an affliction the running game's content lacks.
func find_problems() -> PackedStringArray:
	var problems := PackedStringArray()
	if affliction_id != &"" and AfflictionData.find(affliction_id) == null:
		problems.append("lays unknown affliction '%s'" % affliction_id)
	if scene != null:
		var node := scene.instantiate()
		if not node is Hazard:
			problems.append("hazard scene '%s' is not a Hazard" % scene.resource_path)
		if node != null:
			node.free()
	return problems

func _is_clear(point: Vector2, near: PackedVector2Array) -> bool:
	for other: Vector2 in near:
		if point.distance_to(other) < spacing:
			return false
	return true
