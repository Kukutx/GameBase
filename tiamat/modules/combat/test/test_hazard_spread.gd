extends GutTest

## How a place generated by depth spreads its hazards (`HazardSpread`): how
## many a depth holds, where they stand and what each is made as.

func test_more_hazards_the_deeper_up_to_the_most() -> void:
	var spread := HazardSpread.new()
	spread.from_depth = 3
	spread.every = 2
	spread.most = 4
	assert_eq(spread.count_at(1), 0)
	assert_eq(spread.count_at(2), 0, "none above its first depth")
	assert_eq(spread.count_at(3), 1, "one there")
	assert_eq(spread.count_at(4), 1)
	assert_eq(spread.count_at(5), 2, "one more every second depth")
	assert_eq(spread.count_at(9), 4)
	assert_eq(spread.count_at(400), 4, "and no more than the most")
	spread.most = 0
	assert_eq(spread.count_at(9), 0, "none when it allows none")

func test_hazards_stand_apart_and_clear_of_what_stands_there() -> void:
	var spread := HazardSpread.new()
	spread.from_depth = 1
	spread.every = 1
	spread.most = 5
	spread.spacing = 40.0
	var area := Rect2(-200, -120, 400, 240)
	var taken := PackedVector2Array([Vector2(0, 0), Vector2(100, 50)])
	var left_half := func(point: Vector2) -> bool: return point.x < 60.0
	var places := spread.spread(_rolls("spread"), 5, area, taken, left_half)
	assert_eq(places.size(), 5)
	for index: int in places.size():
		var place := places[index]
		assert_true(area.has_point(place), "within its area")
		assert_true(place.x < 60.0, "where the place accepts it")
		for point: Vector2 in taken:
			assert_gte(place.distance_to(point), 40.0, "clear of what stands there")
		for other: int in index:
			assert_gte(place.distance_to(places[other]), 40.0, "and of each other")
	assert_eq(spread.spread(_rolls("spread"), 5, area, taken, left_half), places, "the same rolls give the same places")
	assert_eq(spread.spread(_rolls("spread"), 2, area, taken, left_half).size(), 2, "as many as the depth holds")

func test_a_hazard_with_no_room_is_left_out() -> void:
	var spread := HazardSpread.new()
	spread.from_depth = 1
	spread.most = 4
	spread.every = 1
	spread.spacing = 50.0
	var places := spread.spread(_rolls("crowded"), 4, Rect2(0, 0, 16, 16))
	assert_eq(places.size(), 1, "a floor too small for two holds one")
	assert_eq(spread.spread(_rolls("crowded"), 4, Rect2(0, 0, 16, 16), PackedVector2Array([Vector2(8, 8)])).size(), 0, "and none where something stands")

func test_each_burns_harder_the_deeper_and_starts_its_share_into_its_cycle() -> void:
	var spread := HazardSpread.new()
	spread.from_depth = 10
	spread.damage_per_depth = 0.5
	var first := spread.make(10)
	assert_eq(first.damage, 10, "a plain hazard's damage at its first depth")
	assert_eq(first.phase_seconds, 0.0)
	first.free()
	var deeper := spread.make(20, 0.25)
	assert_eq(deeper.damage, 15, "half a point more each depth below")
	assert_almost_eq(deeper.phase_seconds, deeper.get_cycle_seconds() * 0.25, 0.001)
	deeper.free()

func test_a_hazard_is_made_from_its_scene() -> void:
	var spread := HazardSpread.new()
	spread.from_depth = 1
	spread.damage_per_depth = 1.0
	var model := Hazard.new()
	model.damage = 20
	model.radius = 30.0
	model.color = Color.MEDIUM_PURPLE
	spread.scene = PackedScene.new()
	assert_eq(spread.scene.pack(model), OK)
	model.free()
	var hazard := spread.make(3)
	assert_eq(hazard.damage, 22)
	assert_eq(hazard.radius, 30.0, "with its scene's reach")
	assert_eq(hazard.color, Color.MEDIUM_PURPLE, "and look")
	hazard.free()
	assert_eq(spread.find_problems(), PackedStringArray())
	var stranger := Node2D.new()
	spread.scene = PackedScene.new()
	spread.scene.pack(stranger)
	stranger.free()
	assert_null(spread.make(3), "a scene that is no hazard makes none")
	assert_eq(spread.find_problems().size(), 1, "and is a problem")

func test_a_hazard_goes_under_the_actors_of_its_place() -> void:
	var place := Node2D.new()
	var ground := Polygon2D.new()
	var player := CharacterBody2D.new()
	var label := Label.new()
	for child: Node in [ground, player, label]:
		place.add_child(child)
	add_child_autofree(place)
	var hazard := Hazard.new()
	Hazard.add_under_actors(place, hazard)
	assert_eq(hazard.get_index(), 1, "over the ground and under the player")
	assert_eq(player.get_index(), 2)
	var bare := Node2D.new()
	add_child_autofree(bare)
	var alone := Hazard.new()
	Hazard.add_under_actors(bare, alone)
	assert_eq(alone.get_parent(), bare, "a place with no actors takes it last")

func _rolls(key: String) -> GameRandomStream:
	return GameRandomStream.new(("fixture_hazards:" + key).sha256_buffer())
