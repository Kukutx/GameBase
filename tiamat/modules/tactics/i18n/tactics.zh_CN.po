msgid "%s is defeated."
msgstr "%s 被击倒了。"

msgid "%s moves."
msgstr "%s 移动了。"

msgid "%s uses %s."
msgstr "%s 使用了%s。"

msgid "%s's turn."
msgstr "轮到 %s 行动。"

msgid "Attack %d · Defense %d · Move %d"
msgstr "攻击 %d · 防御 %d · 移动 %d"

msgid "End Turn"
msgstr "结束回合"

msgid "HP %d/%d"
msgstr "生命 %d/%d"

msgid "Move"
msgstr "移动"

msgid "Undo Move"
msgstr "撤销移动"

msgid "%s steps back."
msgstr "%s 退回原位。"

msgid "Pick a command."
msgstr "选择指令。"

msgid "Pick what it aims at. Cancel goes back."
msgstr "选择目标格。取消可返回。"

msgid "Pick where it moves. Cancel goes back."
msgstr "选择要移动到的格子。取消可返回。"

msgid "Tap what it aims at, then tap it again. × goes back."
msgstr "点选目标格，再点一次确认。点 × 返回。"

msgid "Tap where it moves, then tap it again. × goes back."
msgstr "点选要移动到的格子，再点一次确认。点 × 返回。"

msgid "Grid Battle Speed"
msgstr "战棋速度"

msgid "Standard"
msgstr "标准"

msgid "Grid Foe Strength"
msgstr "战棋敌人强度"

msgid "Weak"
msgstr "弱"

msgid "Strong"
msgstr "强"

msgid "Foes can strike here."
msgstr "敌人下回合能打到这里。"

msgid "%s takes %d"
msgstr "%s 将受到 %d 点伤害"

msgid "%s takes %d and falls"
msgstr "%s 将受到 %d 点伤害并倒下"

msgid "%s regains %d"
msgstr "%s 将恢复 %d 点生命"

msgid "Cover: %d%% less damage"
msgstr "掩护：受到的伤害少 %d%%"

msgid "Rough ground: %d steps to enter"
msgstr "崎岖地形：进入需 %d 步"

msgid "%s (ready in %d)"
msgstr "%s（%d 回合后就绪）"

msgid "%s takes %d, turn delayed"
msgstr "%s 将受到 %d 点伤害，行动延后"

msgid "%s takes %d and falls; their side flees"
msgstr "%s 将受到 %d 点伤害并倒下，其部众溃逃"

msgid "Leader: their side flees when they fall"
msgstr "首领：倒下时其部众溃逃"

msgid "%s falls, and their side flees!"
msgstr "%s 倒下了，其部众溃逃！"

msgid "Goal: a foe that ends a turn here wins"
msgstr "目标：敌方在此结束回合即获胜"

msgid "Goal: end a turn here to win"
msgstr "目标：在此结束回合即可获胜"

msgid "%s takes the goal!"
msgstr "%s 夺下了目标！"

msgid "%s joins the battle."
msgstr "%s 加入了战斗。"

msgid "%s joins the foes!"
msgstr "%s 加入了敌方！"

msgid "Boosts: %s (turns left: %d)"
msgstr "增益：%s（剩余 %d 回合）"

msgid "%s gains %s"
msgstr "%s 将获得 %s"

msgid "Attack %s"
msgstr "攻击 %s"

msgid "Defense %s"
msgstr "防御 %s"

msgid "Hold out: %d s"
msgstr "坚守：%d 秒"

msgid "Time left: %d s"
msgstr "剩余：%d 秒"

msgid "Time is up!"
msgstr "时间到！"

msgid "Hold out for %d seconds of battle."
msgstr "坚守 %d 秒战斗时间。"

msgid "Win within %d seconds of battle."
msgstr "须在 %d 秒战斗时间内取胜。"

msgid "Afflicted: %s"
msgstr "异常状态：%s"

msgid "cures %s"
msgstr "解除%s"

msgid "%s takes %d from %s."
msgstr "%s 受到 %d 点伤害（%s）。"
