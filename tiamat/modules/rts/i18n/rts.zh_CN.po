msgid "%d selected: %s"
msgstr "已选 %d：%s"

msgid "%s falls."
msgstr "%s 倒下了。"

msgid "Attack-Move"
msgstr "攻击移动"

msgid "Click or drag a box to select your units."
msgstr "点击或拖框来选中你的部队。"

msgid "Command Battle"
msgstr "指挥战斗"

msgid "Group %d kept."
msgstr "已编为第 %d 队。"

msgid "Hold"
msgstr "坚守"

msgid "Pick where they attack-move. Cancel drops it."
msgstr "选择攻击移动的目的地。按取消放弃。"

msgid "Select All"
msgstr "全选"

msgid "Stop"
msgstr "停止"

msgid "Command Battle Speed"
msgstr "指挥战斗速度"

msgid "Standard"
msgstr "标准"

msgid "Command Foe Strength"
msgstr "指挥战敌人强度"

msgid "Weak"
msgstr "弱"

msgid "Strong"
msgstr "强"

msgid "(strong against %s)"
msgstr "（克制%s）"

msgid "(inflicts %s)"
msgstr "（施加%s）"

msgid "(cures afflictions)"
msgstr "（解除异常状态）"

msgid "%s: hold the marked ground for %d seconds, or defeat every foe."
msgstr "%s：守住标出的地块 %d 秒，或击败所有敌人。"

msgid "No one holds the ground."
msgstr "无人占据此地。"

msgid "Your units hold the ground."
msgstr "我方占据了此地。"

msgid "The foes hold the ground!"
msgstr "敌方占据了此地！"

msgid "%s: the foes win if they hold the marked ground for %d seconds."
msgstr "%s：敌方若守住标出的地块 %d 秒即获胜。"

msgid "Reinforcements arrive."
msgstr "援军赶到。"

msgid "Foe reinforcements arrive!"
msgstr "敌方援军赶到！"

msgid "Hold out: %d s"
msgstr "坚守：%d 秒"

msgid "Time left: %d s"
msgstr "剩余：%d 秒"

msgid "Time is up!"
msgstr "时间到！"

msgid "%s: hold out for %d seconds of battle."
msgstr "%s：坚守 %d 秒战斗时间。"

msgid "%s: win within %d seconds of battle."
msgstr "%s：须在 %d 秒战斗时间内取胜。"
